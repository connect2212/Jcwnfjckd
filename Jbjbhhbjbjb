-- ฟังก์ชันจัดการระบบบิน (BodyVelocity & BodyGyro)
local function stopFly()
   local player = game.Players.LocalPlayer
   if player.Character then
      local hum = player.Character:FindFirstChildOfClass("Humanoid")
      local hrp = player.Character:FindFirstChild("HumanoidRootPart")
      if hum then
         hum.PlatformStand = false
      end
      if hrp then
         if hrp:FindFirstChild("RayfieldFlyBV") then hrp.RayfieldFlyBV:Destroy() end
         if hrp:FindFirstChild("RayfieldFlyBG") then hrp.RayfieldFlyBG:Destroy() end
      end
   end
   bv = nil
   bg = nil
end

local function startFly()
   local player = game.Players.LocalPlayer
   if not player.Character then return end
   local hrp = player.Character:FindFirstChild("HumanoidRootPart")
   local hum = player.Character:FindFirstChildOfClass("Humanoid")
   if not hrp or not hum then return end

   stopFly()

   hum.PlatformStand = true

   bv = Instance.new("BodyVelocity")
   bv.Name = "RayfieldFlyBV"
   bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
   bv.Velocity = Vector3.zero
   bv.Parent = hrp

   bg = Instance.new("BodyGyro")
   bg.Name = "RayfieldFlyBG"
   bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
   bg.P = 9e4
   bg.CFrame = workspace.CurrentCamera.CFrame
   bg.Parent = hrp
end

