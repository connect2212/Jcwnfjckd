   end
end)

-- ระบบประมวลผลฟิสิกส์ (Stepped Phase)
RunService.Stepped:Connect(function()
   -- Noclip
   if NoclipEnabled and LocalPlayer.Character then
      for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
         if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
         end
      end
   end

   -- Anti-Fling & Anti-Bring System
   if AntiFlingEnabled then
      local myChar = LocalPlayer.Character
      if myChar then
         -- ตั้งค่าแรงเสียดทานต่ำ เพื่อป้องกันการเกาะ/หมุนดัน
         for _, part in pairs(myChar:GetChildren()) do
            if part:IsA("BasePart") then
               part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
            end
         end

         -- ลบสิ่งที่พยายามมาเชื่อมหรือดึงตัวละคร (Anti-Bring / Anti-Weld)
         for _, item in pairs(myChar:GetDescendants()) do
            if item:IsA("Weld") or item:IsA("WeldConstraint") or item:IsA("BodyMover") or item:IsA("AlignPosition") then
               if not item.Name:find("Rayfield") and item.Name ~= "Neck" and item.Name ~= "RootJoint" then
                  item:Destroy()
               end
            end
         end
      end

      -- ปิด CanCollide ของผู้เล่นคนอื่นที่หมุนตัวเร็วป่วนเมือง (Anti-Fling)
      for _, player in pairs(Players:GetPlayers()) do
         if player ~= LocalPlayer and player.Character then
            for _, part in pairs(player.Character:GetChildren()) do
               if part:IsA("BasePart") then
                  if part.AssemblyAngularVelocity.Magnitude > 50 or part.AssemblyLinearVelocity.Magnitude > 250 then
                     part.CanCollide = false
                     part.AssemblyAngularVelocity = Vector3.zero
                     part.AssemblyLinearVelocity = Vector3.zero
                  end
               end
            end
         end
      end
   end

   -- ป้องกันการชนกับฮิตบ็อกขณะเปิด Hitbox Expander
   if HitboxEnabled then
      for _, player in pairs(Players:GetPlayers()) do
         if player ~= LocalPlayer and player.Character then
            for _, part in pairs(player.Character:GetChildren()) do
               if part:IsA("BasePart") then
                  part.CanCollide = false
               end
            end
         end
      end
   end
end)

local function removeTracer(player)
   if Tracers[player] then
      Tracers[player]:Remove()
      Tracers[player] = nil
   end
end

local function updatePlayerESP(player)
   if player == LocalPlayer then return end
   local char = player.Character
   if not char then return end

   local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
   local head = char:FindFirstChild("Head")

   -- 1. Highlight ออร่า
   if HighlightESPEnabled then
      local hl = char:FindFirstChild("RayfieldHighlight")
      if not hl then
         hl = Instance.new("Highlight")
         hl.Name = "RayfieldHighlight"
         hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
         hl.Parent = char
      end
      hl.FillColor = ESPColor
      hl.OutlineColor = Color3.fromRGB(255, 255, 255)
      hl.FillTransparency = 0.5
   else
      if char:FindFirstChild("RayfieldHighlight") then
         char.RayfieldHighlight:Destroy()
      end
   end

   -- 2. Box ESP
   if BoxESPEnabled then
      local box = char:FindFirstChild("RayfieldBox")
      if not box then
         box = Instance.new("SelectionBox")
         box.Name = "RayfieldBox"
         box.LineThickness = 0.05
         box.Adornee = char
         box.Parent = char
      end
      box.Color3 = ESPColor
   else
      if char:FindFirstChild("RayfieldBox") then
         char.RayfieldBox:Destroy()
      end
   end

   -- 3. Name & Distance ESP
   if (NameESPEnabled or DistanceESPEnabled) and head then
      local tag = head:FindFirstChild("RayfieldTag")
      if not tag then
         tag = Instance.new("BillboardGui")
         tag.Name = "RayfieldTag"
         tag.Size = UDim2.new(0, 200, 0, 50)
         tag.StudsOffset = Vector3.new(0, 3, 0)
         tag.AlwaysOnTop = true
         tag.Parent = head

         local label = Instance.new("TextLabel")
         label.Name = "ESPText"
         label.Size = UDim2.new(1, 0, 1, 0)
         label.BackgroundTransparency = 1
         label.Font = Enum.Font.SourceSansBold
         label.TextSize = 14
         label.TextStrokeTransparency = 0
         label.Parent = tag
      end

      local textStr = ""
      local localHrp = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("Torso"))
      if localHrp and hrp then
         local dist = math.floor((localHrp.Position - hrp.Position).Magnitude)
         if NameESPEnabled and DistanceESPEnabled then
            textStr = player.DisplayName .. " [" .. dist .. "m]"
         elseif NameESPEnabled then
            textStr = player.DisplayName
         elseif DistanceESPEnabled then
            textStr = "[" .. dist .. "m]"
         end
      elseif NameESPEnabled then
         textStr = player.DisplayName
      end

      local label = tag:FindFirstChild("ESPText")
      if label then
         label.Text = textStr
         label.TextColor3 = ESPColor
      end
   else
      if head and head:FindFirstChild("RayfieldTag") then
         head.RayfieldTag:Destroy()
      end
   end
end

-- ระบบทำงานแบบ RenderStepped (กราฟิก/ปรับขนาดวัตถุ)
RunService.RenderStepped:Connect(function()
   -- ปรับขนาดฮิตบ็อก
   if HitboxEnabled then
      for _, player in pairs(Players:GetPlayers()) do
         if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local targetPart = char:FindFirstChild("HumanoidRootPart") 
               or char:FindFirstChild("Torso") 
               or char:FindFirstChild("UpperTorso") 
               or char:FindFirstChild("Head")

            if targetPart then
               targetPart.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
               targetPart.Transparency = HitboxTransparency
               targetPart.Massless = true
            end
         end
      end
   end

   -- ระบบการบิน
   if FlyEnabled and LocalPlayer.Character then
      local char = LocalPlayer.Character
      local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
      local hum = char:FindFirstChildOfClass("Humanoid")

      if hrp and hum then
         if not hrp:FindFirstChild("RayfieldFlyBV") or not hrp:FindFirstChild("RayfieldFlyBG") then
            startFly()
         end

         if bv and bg then
            hum.PlatformStand = true

            bg.CFrame = Camera.CFrame

            local moveDir = hum.MoveDirection
            if moveDir.Magnitude > 0 then
               local camCF = Camera.CFrame
               local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
               local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)

               if flatLook.Magnitude > 0 then flatLook = flatLook.Unit end
               if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end

               local forwardAmount = moveDir:Dot(flatLook)
               local rightAmount = moveDir:Dot(flatRight)

               local flyVector = (camCF.LookVector * forwardAmount) + (camCF.RightVector * rightAmount)
               if flyVector.Magnitude > 0 then
                  bv.Velocity = flyVector.Unit * FlySpeed
               else
                  bv.Velocity = Vector3.zero
               end
            else
               bv.Velocity = Vector3.zero
            end
         end
      end
   else
      if bv or bg then
         stopFly()
      end
   end

   -- อัปเดต ESP
   for _, player in pairs(Players:GetPlayers()) do
    
